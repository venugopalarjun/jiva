  .logo svg{width:27px;height:27px;}
  .back{font-size:14px;color:var(--ink-2);}
  .back:hover{color:var(--ink);}
  main{padding:56px 0 40px;}
  .lede h1{font-family:var(--serif);font-weight:500;font-size:clamp(32px,5vw,46px);
           line-height:1.1;letter-spacing:-0.01em;margin-bottom:14px;color:var(--ink);}
  .lede p{font-family:var(--serif);font-size:20px;line-height:1.5;color:var(--ink-2);
          margin-bottom:12px;max-width:640px;}
  .list{margin-top:46px;border-top:0.5px solid var(--hairline);}
  .post{display:block;padding:26px 0;border-bottom:0.5px solid var(--hairline);}
  .post .date{font-size:13px;color:var(--ink-3);text-transform:uppercase;letter-spacing:0.05em;margin-bottom:8px;}
  .post h2{font-family:var(--serif);font-weight:500;font-size:26px;line-height:1.2;color:var(--ink);margin-bottom:8px;}
  .post .sum{font-family:var(--serif);font-size:18px;line-height:1.5;color:var(--ink-2);}
  .post:hover h2{color:var(--clay-dark);}
  .more{color:var(--ink-3);font-size:15px;margin-top:34px;}
  footer{border-top:0.5px solid var(--hairline);margin-top:8px;}
  .foot{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;
        padding:22px 0;color:var(--ink-3);font-size:13px;max-width:960px;margin:0 auto;padding-left:24px;padding-right:24px;}
  .foot .l{display:flex;align-items:center;gap:7px;}
  .foot svg{width:14px;height:14px;}
  .foot a{color:var(--ink-3);}
</style>
